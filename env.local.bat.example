@echo off
rem Copy this file to env.local.bat and edit the values.
rem env.local.bat is gitignored and loaded by start_webui.bat automatically.

rem Capture directory used by decrypt_all_v2.py / scripts (absolute or relative).
rem set AUTOBA_CAPTURE_DIR=capture\ba

rem unidbg fallback (optional; only needed for offline_sign_unidbg / reverse oracle scripts).
rem set AUTOBA_UNIDBG_WORK=unidbg
rem set AUTOBA_AIRI_SO=capture\libairisgcore.so

rem WebUI port (default 8800).
rem set AUTOBA_PORT=8800
